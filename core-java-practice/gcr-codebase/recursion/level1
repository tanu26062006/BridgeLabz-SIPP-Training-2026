//scenario 1
 import java.util.Scanner;

public class IncreasingReadings {

    public static boolean isStrictlyIncreasing(int[] arr, int index) {

        // Base case
        if (index == arr.length - 1) {
            return true;
        }

        // Check current and next element
        if (arr[index] >= arr[index + 1]) {
            return false;
        }

        // Recursive call
        return isStrictlyIncreasing(arr, index + 1);
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of readings: ");
        int n = sc.nextInt();

        int[] readings = new int[n];

        System.out.println("Enter readings:");
        for (int i = 0; i < n; i++) {
            readings[i] = sc.nextInt();
        }

        boolean result = isStrictlyIncreasing(readings, 0);

        System.out.println(result);

        sc.close();
    }
}
