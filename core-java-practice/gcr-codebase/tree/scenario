import java.util.*;

public class TreeScenarios {

    
    // Tree Node
   
    static class Node {
        int val;
        Node left, right;

        Node(int val) {
            this.val = val;
        }
    }


    // Scenario 1: Recursive Inorder (BST Sorted Traversal)
   

    public List<Integer> getSortedLeaderboard(Node root) {
        List<Integer> result = new ArrayList<>();
        inorder(root, result);
        return result;
    }

    private void inorder(Node node, List<Integer> result) {
        if (node == null)
            return;

        inorder(node.left, result);
        result.add(node.val);
        inorder(node.right, result);
    }

    
    // Scenario 2: Iterative Preorder

    public List<Integer> iterativePreorder(Node root) {

        List<Integer> result = new ArrayList<>();

        if (root == null)
            return result;

        Stack<Node> stack = new Stack<>();
        stack.push(root);

        while (!stack.isEmpty()) {

            Node curr = stack.pop();

            result.add(curr.val);

            if (curr.right != null)
                stack.push(curr.right);

            if (curr.left != null)
                stack.push(curr.left);
        }

        return result;
    }

    
    // Scenario 3: Level Order Traversal (BFS)
   

    public List<List<Integer>> broadcastByLevel(Node root) {

        List<List<Integer>> result = new ArrayList<>();

        if (root == null)
            return result;

        Queue<Node> queue = new LinkedList<>();
        queue.offer(root);

        while (!queue.isEmpty()) {

            int size = queue.size();

            List<Integer> level = new ArrayList<>();

            for (int i = 0; i < size; i++) {

                Node curr = queue.poll();

                level.add(curr.val);

                if (curr.left != null)
                    queue.offer(curr.left);

                if (curr.right != null)
                    queue.offer(curr.right);
            }

            result.add(level);
        }

        return result;
    }

   
    // Scenario 4: Height of Tree


    public int height(Node root) {

        if (root == null)
            return -1;

        return Math.max(height(root.left),
                height(root.right)) + 1;
    }

    public boolean isTooDeep(Node root, int threshold) {
        return height(root) > threshold;
    }

    
    // Scenario 5: Diameter of Tree
   

    int diameter = 0;

    public int longestCommunicationPath(Node root) {

        diameter = 0;

        heightDiameter(root);

        return diameter;
    }

    private int heightDiameter(Node node) {

        if (node == null)
            return -1;

        int left = heightDiameter(node.left);

        int right = heightDiameter(node.right);

        diameter = Math.max(diameter,
                left + right + 2);

        return Math.max(left, right) + 1;
    }

    // Scenario 6: Postorder Traversal
   

    public void deleteFolderTree(Node root) {

        if (root == null)
            return;

        deleteFolderTree(root.left);

        deleteFolderTree(root.right);

        System.out.print(root.val + " ");
    }



    public static Node createTree() {

        Node root = new Node(10);

        root.left = new Node(5);
        root.right = new Node(15);

        root.left.left = new Node(3);
        root.left.right = new Node(7);

        root.right.left = new Node(12);
        root.right.right = new Node(18);

        return root;
    }

   

    public static void main(String[] args) {

        TreeScenarios obj = new TreeScenarios();

        Node root = createTree();

        System.out.println("Scenario 1: Inorder");
        System.out.println(obj.getSortedLeaderboard(root));

        System.out.println();

        System.out.println("Scenario 2: Preorder");
        System.out.println(obj.iterativePreorder(root));

        System.out.println();

        System.out.println("Scenario 3: Level Order");
        System.out.println(obj.broadcastByLevel(root));

        System.out.println();

        System.out.println("Scenario 4: Height");
        System.out.println(obj.height(root));

        System.out.println("Too Deep (>2)?");
        System.out.println(obj.isTooDeep(root, 2));

        System.out.println();

        System.out.println("Scenario 5: Diameter");
        System.out.println(obj.longestCommunicationPath(root));

        System.out.println();

        System.out.println("Scenario 6: Postorder");
        obj.deleteFolderTree(root);
    }
}