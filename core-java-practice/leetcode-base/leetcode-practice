//day2 problem1281
class Solution {
    public int subtractProductAndSum(int n) {
        
        int product = 1;
        int sum = 0;

        while (n > 0) {
            int digit = n % 10;

            product *= digit;
            sum += digit;

            n = n / 10;
        }

        return product - sum;
    }
}
//problem1342
class Solution {
    public int numberOfSteps(int num) {

        int steps = 0;

        while (num > 0) {

            if (num % 2 == 0) {
                num = num / 2;
            } else {
                num = num - 1;
            }

            steps++;
        }

        return steps;
    }
}
